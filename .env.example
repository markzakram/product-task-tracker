# ============================================================
#  BERKAS INI DILACAK GIT. Jangan pernah mengisinya dengan nilai sungguhan —
#  kata sandi yang ditulis di sini akan ikut ter-commit dan ter-push.
#  Yang diisi adalah .env (disalin dari berkas ini), dan .env diabaikan git.
#
#  ENVIRONMENT VARIABLES — ProductTrack
#
#  Daftar ini LENGKAP: setiap variabel yang dibaca kode di api/ ada di sini,
#  diperiksa langsung dari kodenya (process.env.X dan envList('X')).
#  Kalau menyiapkan server baru, jangan berhenti di yang sudah terisi contohnya.
#
#  Tanda di tiap variabel:
#    [WAJIB]          aplikasi atau fiturnya mati tanpa ini
#    [RAHASIA]        jangan dikirim lewat chat/email biasa
#    [SAMAKAN]        harus SAMA PERSIS dengan server lama, jangan dibuat baru
#    [OPSIONAL]       kosong = memakai nilai bawaan yang disebut
#
#  Untuk tim IT: kirimkan BERKAS INI sebagai rujukan. Nilai-nilai rahasianya
#  diserahkan lewat jalur yang aman, bukan disalin ke sini.
# ============================================================


# ------------------------------------------------------------
#  1) LINGKUNGAN
# ------------------------------------------------------------

# [WAJIB di luar Vercel] Nama lingkungan: production / preview / development.
#
# Di Vercel ini terisi sendiri lewat VERCEL_ENV. Di server lain TIDAK — dan
# kalau dibiarkan kosong, server melaporkan dirinya 'development', lalu
# SELURUH aplikasi produksi tampil dengan strip kuning STAGING di layar
# setiap orang. Server produksi WAJIB mengisi: APP_ENV=production
#
# Lokal: biarkan kosong (= development, dan memang benar begitu).
APP_ENV=


# ------------------------------------------------------------
#  2) SPREADSHEET (sumber data saat ini)
# ------------------------------------------------------------

# [WAJIB] ID Google Spreadsheet. Ambil dari URL:
#         https://docs.google.com/spreadsheets/d/<INI_ID_NYA>/edit
SPREADSHEET_ID=1AbcDEfgHIjkLMnopQRstuVWxyz1234567890abcd

# [WAJIB di server] [RAHASIA] Kredensial service account, SELURUH JSON dalam SATU baris.
#
#    PERINGATAN: contoh di bawah punya private key PALSU. Ia lolos JSON.parse lalu gagal
#    jauh di dalam OpenSSL dengan "DECODER routines::unsupported" — pesan yang tak
#    menyebut apa pun yang berguna. Karena itu baris aslinya dibiarkan KOSONG.
#
#    Bentuknya kira-kira begini, satu baris penuh (JANGAN disalin apa adanya):
#    GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"xxx","private_key_id":"xxx","private_key":"-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n","client_email":"task-tracker@xxx.iam.gserviceaccount.com","client_id":"xxx","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/task-tracker%40xxx.iam.gserviceaccount.com"}
#
#    Di server: WAJIB diisi.
#    Di lokal : biarkan KOSONG, taruh credentials.json di akar repo. Kalau baris ini
#               terisi apa pun, ia MENANG atas berkas itu dan berkas itu diabaikan.
GOOGLE_SERVICE_ACCOUNT_JSON=

# [OPSIONAL] Nama tab task di spreadsheet. Bawaan: Main
MAIN_SHEET_NAME=


# ------------------------------------------------------------
#  3) SAKLAR SUMBER DATA
# ------------------------------------------------------------

# [OPSIONAL] 'sheets' atau 'mysql'. Kosong = sheets.
#
# Dipakai api/rpc.js DAN api/metrics.js lewat api/_backend.js, jadi keduanya
# selalu menunjuk sumber yang sama. Nilai lain (mis. salah ketik "mysq1")
# DITOLAK keras — seluruh API berhenti — bukan diam-diam jatuh ke sheets.
#
# Belum boleh diisi 'mysql' di produksi: periksa dulu dengan
#     node scripts/banding/siap.js
DATA_SOURCE=


# ------------------------------------------------------------
#  4) MYSQL (hanya dipakai kalau DATA_SOURCE=mysql, dan oleh skrip migrasi)
# ------------------------------------------------------------
#  Server ini hanya menerima sambungan dari jaringan yang diizinkan IT —
#  dari luar (mis. Vercel) hasilnya `connect ETIMEDOUT`.
#  Panduan lengkap: docs/MIGRASI-MYSQL.md

MYSQL_HOST=34.128.116.164
MYSQL_PORT=3306
MYSQL_USER=produk_db
# [RAHASIA]
MYSQL_PASSWORD=
MYSQL_DATABASE=produk_base

# [OPSIONAL] Berkas CA dari IT. Tanpa ini sambungan tetap TERENKRIPSI,
#            tapi identitas server tidak diverifikasi.
MYSQL_CA=

# [OPSIONAL] Jumlah sambungan per instance. Bawaan: 2.
#            Server MySQL ini dipakai bersama tim lain dan batasnya pernah
#            tertabrak — jangan dinaikkan tanpa alasan.
MYSQL_POOL=


# ------------------------------------------------------------
#  5) AKSES & PIN
# ------------------------------------------------------------
#  Nilai contoh PIN sengaja DIKOSONGKAN. Berkas ini ada di git (dan kini di
#  GitLab juga), jadi PIN apa pun yang ditulis di sini sudah bukan rahasia.
#  Server baru WAJIB memakai PIN yang tak pernah tertulis di repo.

# [WAJIB] [RAHASIA] PIN karyawan -> akses penuh sesuai perannya.
ACCESS_PIN=

# [OPSIONAL] [RAHASIA] PIN anak magang -> level terbatas. Server hanya mengirim
#            task lingkungan magang; task karyawan tak pernah sampai ke perangkat
#            mereka. Kosong = jalur magang mati.
MAGANG_PIN=

# [OPSIONAL] [RAHASIA] PIN lihat-saja (Lintas Divisi): baca terbatas + chat.
#            Kosong = jalur lihat-saja mati.
VIEW_PIN=

# [WAJIB di server] [RAHASIA] PIN mode Dev (kelola user & peran).
#
#   PERHATIAN — kosong TIDAK mematikan mode Dev. Kodenya:
#       const DEV_PIN = process.env.DEV_PIN || '3108'
#   Jadi kalau dibiarkan kosong, mode Dev TERBUKA dengan PIN 3108 — dan angka
#   itu tertulis di kode yang bisa dibaca siapa pun yang punya akses repo.
#   Server WAJIB mengisinya dengan PIN yang tak pernah tertulis di mana pun.
DEV_PIN=

# [SAMAKAN] Garam untuk hash PIN per-user di sheet AUTH. Bawaan: pt_pin_salt_v1
#
#   JANGAN dibuat baru di server pindahan. PIN tiap user disimpan sebagai hash
#   yang dibuat memakai garam ini; garam yang berbeda membuat SEMUA PIN user
#   langsung tak cocok, dan semua orang tak bisa masuk.
#
#   Samakan dengan server lama. Kalau server lama tak pernah mengisinya, biarkan
#   KOSONG di server baru juga — supaya bawaannya yang sama dipakai.
PIN_SALT=

# [OPSIONAL] Nama lama untuk ACCESS_PIN — hanya dibaca kalau ACCESS_PIN kosong.
#            Tak perlu diisi di pemasangan baru.
APP_PASSWORD=


# ------------------------------------------------------------
#  6) LOGIN GOOGLE UNTUK ADMIN
# ------------------------------------------------------------
#  Ketiganya berpasangan. Login Google hanya menyala kalau GOOGLE_CLIENT_ID
#  DAN SESSION_SECRET terisi; kalau salah satu kosong, tombolnya tak muncul.

# [OPSIONAL] OAuth Client ID dari Google Cloud Console.
#            PERHATIAN untuk server pindahan: Client ID ini terikat ke domain.
#            Domain baru harus didaftarkan di "Authorized JavaScript origins"
#            pada Google Cloud Console, kalau tidak login Google ditolak.
GOOGLE_CLIENT_ID=

# [RAHASIA] Kunci penanda tangan sesi admin (HMAC). Isi dengan string acak panjang:
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Menggantinya membuat semua sesi admin yang sedang aktif harus masuk ulang.
SESSION_SECRET=

# [OPSIONAL] Email yang boleh masuk sebagai admin lewat Google, pisah koma.
AUTHORIZED_EMAILS=


# ------------------------------------------------------------
#  7) PERAN
# ------------------------------------------------------------
#  Ketiganya cadangan: sumber utama peran adalah sheet USERS. Daftar ini
#  dipakai kalau sheet itu belum mengatur perannya.

# [OPSIONAL] Manager — bisa melihat SEMUA task lintas PIC. Pisah koma.
MANAGERS=Nynda

# [OPSIONAL] Yang boleh menandai task Done. Bawaan: Nynda,Dhea,Alya
DONE_APPROVERS=

# [OPSIONAL] Pengelola task kolaborasi. Bawaan: Nynda,Dhea,Alya
COLLAB_MANAGERS=


# ------------------------------------------------------------
#  8) WAKTU
# ------------------------------------------------------------

# [OPSIONAL] Selisih zona waktu server -> waktu lokal, dalam menit.
#            420 = WIB (UTC+7). WITA=480, WIT=540.
TIMEZONE_OFFSET_MINUTES=420


# ------------------------------------------------------------
#  9) ENDPOINT METRICS (api/metrics.js) — dipakai sistem OKR manager
# ------------------------------------------------------------

# [RAHASIA] Token baca-saja, format nama:token, pisah koma.
#   Beri token BERBEDA per orang/sistem supaya bisa dicabut satu-satu.
#   Kosong = endpoint tertutup sepenuhnya. Buat token acak:
#     node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
#   Contoh bentuknya: manager:<token>,okr-mcp:<token-lain>
METRICS_TOKENS=

# [OPSIONAL] [RAHASIA] Satu token tanpa nama. Bentuk lama dari METRICS_TOKENS;
#            keduanya boleh dipakai bersamaan.
METRICS_TOKEN=

# [OPSIONAL] Lama cache hasil baca, dalam detik. Bawaan: 45. 0 = tanpa cache.
METRICS_CACHE_SECONDS=45


# ------------------------------------------------------------
#  10) SHEET OKR (dipakai api/mcp.js untuk tool okr_*)
# ------------------------------------------------------------
#  Spreadsheet TERPISAH milik manager — bukan bagian dari migrasi MySQL.
#  Cukup di-share ke service account sebagai Viewer.

# [OPSIONAL] Kosong = tool okr_* mati; tool task_* tetap jalan normal.
OKR_SHEET_ID=

# [OPSIONAL] Nama tab di sheet OKR. Bawaan: OKR
OKR_SHEET_TAB=OKR


# ------------------------------------------------------------
#  11) PERKAKAS LOKAL — TIDAK untuk server
# ------------------------------------------------------------

# Spreadsheet UJI untuk alat banding fungsi tulis (scripts/banding/tulis.js).
# Alat itu MEMBUAT dan MENGHAPUS baris, jadi ia menolak jalan kalau nilainya
# sama dengan SPREADSHEET_ID. Pakai sheet staging — lihat docs/STAGING.md.
SPREADSHEET_ID_UJI=
