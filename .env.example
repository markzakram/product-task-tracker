# ============================================================
#  CONTOH ENVIRONMENT VARIABLES — Task Tracker (Vercel)
#  Salin nilai-nilai ini ke Vercel: Project Settings > Environment Variables
#  JANGAN commit file .env asli ke Git.
# ============================================================

# 1) ID Google Spreadsheet tujuan (sama dengan yang dipakai Apps Script).
#    Ambil dari URL: https://docs.google.com/spreadsheets/d/<INI_ID_NYA>/edit
SPREADSHEET_ID=1AbcDEfgHIjkLMnopQRstuVWxyz1234567890abcd

# 2) Kredensial Service Account (isi SELURUH JSON dalam SATU baris).
#    Didapat saat membuat key JSON service account di Google Cloud.
#    Tips: buka file JSON, copy semua isinya, tempel sebagai satu nilai.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"xxx","private_key_id":"xxx","private_key":"-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n","client_email":"task-tracker@xxx.iam.gserviceaccount.com","client_id":"xxx","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/task-tracker%40xxx.iam.gserviceaccount.com"}

# 3) (Opsional) Daftar nama manager, pisahkan dengan koma.
#    Manager bisa melihat SEMUA task lintas PIC. Default: Nynda
MANAGERS=Nynda

# 4) (Opsional) Selisih zona waktu server -> waktu lokal (menit).
#    Default 420 = WIB (UTC+7). WITA=480, WIT=540.
TIMEZONE_OFFSET_MINUTES=420

# 5) PIN gerbang aplikasi.
#    ACCESS_PIN  = PIN karyawan  -> akses penuh sesuai perannya
#    MAGANG_PIN  = PIN anak magang -> level terbatas. Server HANYA mengirim task
#                  lingkungan magang; task karyawan tidak pernah sampai ke perangkat
#                  mereka. Identitas dipilih sekali lalu terkunci di cookie.
#    VIEW_PIN    = PIN lihat-saja (Lintas Divisi), baca terbatas + chat.
#    Kosongkan salah satunya untuk menonaktifkan jalur itu.
ACCESS_PIN=676767
MAGANG_PIN=345345
VIEW_PIN=

# 6) PIN mode Dev (kelola user & peran). Kosong = mode Dev nonaktif.
DEV_PIN=3108

# 7) Token endpoint METRICS (api/metrics.js) — kontrak read-only untuk sistem luar
#    (mis. sistem OKR manager). Format: nama:token, dipisah koma.
#    Beri token BERBEDA per orang/sistem supaya bisa dicabut satu-satu tanpa
#    mengganggu yang lain. Kosongkan untuk menutup endpoint sepenuhnya.
#    Bikin token acak:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
METRICS_TOKENS=manager:ganti_dengan_token_acak,okr-mcp:ganti_dengan_token_acak_lain

#    (Opsional) Lama cache hasil baca sheet, dalam detik. Default 45.
#    Menaikkan ini menghemat kuota Google saat sering ditanya; menurunkannya
#    membuat angka lebih segar. 0 = tanpa cache.
METRICS_CACHE_SECONDS=45

# 8) Sheet OKR (dipakai api/mcp.js untuk tool okr_*).
#    Ambil ID dari URL: https://docs.google.com/spreadsheets/d/<INI_ID_NYA>/edit
#    Sheet-nya cukup di-share ke service account sebagai Viewer.
#    Kosongkan kalau sheet OKR belum ada — tool task_* tetap jalan normal.
OKR_SHEET_ID=
#    (Opsional) Nama tab di sheet OKR. Default: OKR
OKR_SHEET_TAB=OKR
